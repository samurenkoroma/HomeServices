    "version": "0.2.0",
    "configurations": [

        
        {
            "name": "api",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "envFile": "${workspaceFolder}/.env",
            "program": "${workspaceFolder}/cmd/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "scaner",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": ["scan","/mnt/bookdir"],
            "envFile": "${workspaceFolder}/.env",
            "program": "${workspaceFolder}/cmd/scaner/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "opc",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/practic/opcclient/main.go",
            "cwd": "${workspaceFolder}"
        }

    ]
}